---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import duckCookie from "../assets/duck-cookie.svg";
import downArrow from "../assets/down-arrow.svg";
import Projects from "../components/Projects.astro";
import Services from "../components/Services.astro";
import Faq from "../components/Faq.astro";
import { description, secondaryDescription } from "../data/copy.ts";
import CalendlyButton from '../components/CalendlyButton.astro';
---

<Layout>
	<div class="
   flex flex-col bg-[url('../assets/background.png')] bg-cover bg-center
   bg-repeat
 ">
		<section class="
    mx-auto flex h-screen w-screen flex-col gap-80 p-18 font-default
  ">
			<div class="relative">
				<div class="absolute max-w-250 rounded-2xl bg-[#b7e3ac] px-8 py-6 outline-2">
					<h1 id="description" class="font-default text-5xl/heading-none">{description}</h1>
				</div>
				<div class="
      absolute top-5 left-5 max-w-250 rounded-2xl bg-[#b7e3ac] px-8 py-6
      outline-2
    ">
					<h1 id="description" class="font-default text-5xl/heading-none">{description}</h1>
				</div>
				<div class="
      absolute top-10 left-10 max-w-250 rounded-2xl bg-[#b7e3ac] px-8 py-6
      outline-2
    ">
					<h1 id="description" class="font-default text-5xl/heading-none">{description}</h1>
				</div>
			</div>
			<div class="relative">
				<div class="
      absolute -right-10 flex max-w-250 flex-col gap-4 rounded-2xl px-8 py-6
      outline-2
    ">
					<h3 class="font-default text-2xl/10">{secondaryDescription}</h3>
					<CalendlyButton text="Book a free consultation" />
				</div>
			</div>
			
			<div class="flex flex-row items-center justify-center gap-2">
				<img src={downArrow.src} class="size-8"/>
				<p>Scroll down</p>
			</div>
		</section>
		<Services />
		<Projects />
		<Faq />
	</div>
</Layout>

<script>
	import { gsap } from "gsap";
	import { TextPlugin } from "gsap/TextPlugin";
	
	gsap.registerPlugin(TextPlugin);

	const description = document.getElementById("description");
	const newDescriptionText = description?.dataset.text;

	if (newDescriptionText) {
		gsap.to(description, {
			duration: 10,
			text: {
				value: newDescriptionText,
				newClass: "text-[#D4DE95]",
				padSpace: true,
			},
			ease: "none",
			delay: 3,
			speed: 20,
		})
	}
</script>
