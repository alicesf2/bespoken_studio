---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import downArrow from "../assets/down-arrow.svg";
import Clients from "../components/Clients.astro";
import Projects from "../components/Projects.astro";
import Services from "../components/Services.astro";
import Faq from "../components/Faq.astro";
import { description, secondaryDescription } from "../data/copy.ts";
import CalendlyButton from "../components/CalendlyButton.astro";
import ButtonWrapper from "../components/ButtonWrapper.astro";
import lilypadLeft from "../assets/lilypad-left.svg";
import cloud from "../assets/cloud.svg";
import tree from "../assets/tree.svg";
import speech from "../assets/speech.svg";
---

<Layout>
  <div
    class="
      flex flex-col bg-[url('../assets/background.png')] bg-cover bg-center
      bg-repeat
    "
  >
    <section
      class="
        mx-auto h-screen w-screen font-default
        xl:max-w-450
      "
    >
      <div class="flex h-[80%] flex-row gap-18 p-18">
        <div class="relative w-1/2">
          <img class="scale-115" src={cloud.src} />
          <div id="description-wrapper" class="absolute top-40 left-20 flex">
            <span id="description" class="text-4xl/12"></span>
            <span id="cursor" class="m-0 inline-block text-black">|</span>
          </div>
        </div>
        <div class="relative mt-32 w-1/2">
          <img class="scale-120" src={cloud.src} />
          <div class="
            absolute inset-0 top-30 flex flex-col justify-center gap-4 px-12
          ">
            <p class="w-full text-2xl/8">{secondaryDescription}</p>
            <!-- <div class="flex flex-row justify-center gap-4">
              <ButtonWrapper id="learn-more" text="Learn More" />
              <CalendlyButton />
            </div> -->
          </div>
        </div>
      </div>
      <div class="relative flex flex-row gap-4">
        <div class="absolute -top-35 left-35 flex flex-row">
          <img src={tree.src} class="w-50" />
          <div class="relative">
            <img src={speech.src} class="w-50 self-start" />
            <button class="
              absolute top-5 left-1/2 w-full -translate-x-1/2 cursor-pointer
              text-xl
            ">book consultation</button>
          </div>
        </div>
        <div class="absolute top-4 left-100 flex flex-row">
          <img src={tree.src} class="w-30" />
          <div class="relative">
            <img src={speech.src} class="w-50 self-start" />
            <button id="learn-more" class="
              absolute top-5 left-1/2 -translate-x-1/2 cursor-pointer text-xl
            ">learn more</button>
          </div>
        </div>
      </div>
    </section>
    <!-- <Clients /> -->
    <Services />
    <Projects />
    <Faq />
  </div>
</Layout>

<script>
  import { gsap } from "gsap";
  import { TextPlugin } from "gsap/TextPlugin";
  import { ScrollToPlugin } from "gsap/ScrollToPlugin";
  import { description } from "../data/copy.ts";

  gsap.registerPlugin(TextPlugin);
  gsap.registerPlugin(ScrollToPlugin);

  // Blinking cursor animation
  let cursor = document.querySelector("#cursor");
  let descriptionEl = document.querySelector("#description");

  gsap.fromTo(
    cursor,
    { autoAlpha: 0, x: 2 },
    { autoAlpha: 1, duration: 0.5, repeat: -1, ease: "steps(1)" },
  );

  gsap.to("#description", {
    text: {
      value: description,
    },
    duration: 5,
    delay: 1,
    ease: "none",
    onUpdate: () => descriptionEl?.appendChild(cursor),
  });

  // Learn more scroll animation
  const learnMoreBtn = document.getElementById("learn-more");

  learnMoreBtn?.addEventListener("click", () => {
    gsap.to(window, {
      duration: 1,
      scrollTo: "#services",
      onComplete: () => {
        gsap.set("#navbar", {
          display: "block",
          position: "fixed",
          top: 0,
          opacity: 0,
        });

        gsap.to("#navbar", {
          opacity: 1,
          duration: 0.5,
          ease: "power2.out",
        });
      },
    });
  });
</script>
