---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import duckCookie from "../assets/duck-cookie.svg";
import Projects from "../components/Projects.astro";
import Services from "../components/Services.astro";
import Faq from "../components/Faq.astro";
import { headings, secondaryDescription } from "../data/copy.ts";

const randomIndex = Math.floor(Math.random() * 3);
const oldDescription = headings[randomIndex].oldDescription;
const newDescription = headings[randomIndex].newDescription;
---

<Layout>
	<div class="mt-24 flex flex-col">
		<section class="mx-auto flex h-[calc(100vh-80px)] max-w-300 flex-col gap-12">
			<h1 id="description" class="
     font-default text-4xl/heading-none text-[#16180A]
   " data-text={newDescription}>{oldDescription}</h1>		
			<div class="flex flex-row gap-12">
				<img src={duckCookie.src} class="size-80"/>
				<div class="flex flex-col gap-12">
					<h3 class="font-default text-2xl/10 text-[#D4DE95]">{secondaryDescription}</h3>
				</div>
			</div>
			<p>Scroll down</p>
		</section>
		<Services />
		<Projects />
		<Faq />
	</div>
</Layout>

<script>
	import { gsap } from "gsap";
	import { TextPlugin } from "gsap/TextPlugin";
	
	gsap.registerPlugin(TextPlugin);

	const description = document.getElementById("description");
	const newDescriptionText = description?.dataset.text;

	if (newDescriptionText) {
		gsap.to(description, {
			duration: 10,
			text: {
				value: newDescriptionText,
				newClass: "text-[#D4DE95]",
				padSpace: true,
			},
			ease: "none",
			delay: 3,
			speed: 20,
		})
	}
</script>
