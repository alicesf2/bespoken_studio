---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";

const servicesData = [
  {
    name: "design",
    description:
      "high-fidelity mockups of the website for desktop and mobile layouts",
    timeline: "1 week",
    price: 250,
  },
  {
    name: "development",
    description: `coding the website and publishing it to the web. includes configuration of content management
                  system and design tweaks as necessary.`,
    timeline: "2-3 weeks",
    price: 500,
  },
  {
    name: "seo & analytics",
    description: `hooking up services like google analytics to track metrics across the
                  site, and improving online visibility and traffic`,
    timeline: "1 week",
    price: 100,
  },
  {
    name: "special build",
    description: `anything highly interactive, including but not limited to animations,
                  custom layouts, media, games, etc.`,
    timeline: "variable",
    price: -1,
  },
];
---

<Layout>
  <section class="font-default p-12 flex flex-col gap-4 items-center">
    <div class="grid grid-cols-4 gap-8">
      {servicesData.map((service) => (
        <div class="shadow-lg bg-white/30 rounded-[48px] backdrop-blur-2xl p-8 flex flex-col gap-2 justify-between">
          <div class="flex flex-col gap-2">
            <h1 class="text-2xl text-center underline decoration-1 underline-offset-3">
              {service.name}
            </h1>
            <p class="text-xl font-thin">{service.description}</p>
          </div>
          <div class="text-xl font-thin">
            <p>timeline: {service.timeline}</p>
            <p>
              price:{" "}
              {service.price === -1 ? "variable" : `$${service.price} USD`}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
