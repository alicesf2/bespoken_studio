---
interface QaPair {
  question: string;
  answer: string;
}

const { qaPairs } = Astro.props;
---

<div id="accordion-collapse" data-accordion="collapse" class="
  mb-12 overflow-hidden rounded-2xl bg-[#BAC095] outline-2
">
  {qaPairs.map((pair: QaPair, i: number) => (
    <h2 id={`accordion-collapse-heading-${i}`}>
        <button type="button" class="
          flex w-full items-center justify-between gap-3 rounded-t-base border
          border-x-0 border-t-0 border-b-2 p-5 font-bold text-body
          hover:bg-neutral-secondary-medium hover:text-heading
          rtl:text-right
        " data-accordion-target={`#accordion-collapse-body-${i}`} aria-expanded="true" aria-controls="accordion-collapse-body-1">
          <span>{pair.question}</span>
          <svg data-accordion-icon class="size-5 shrink-0 rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 15 7-7 7 7"/></svg>
        </button>
      </h2>
    <div id={`accordion-collapse-body-${i}`} class="hidden border-b-2" aria-labelledby={`#accordion-collapse-heading-${i}`}>
      <div class="
        p-4
        md:p-5
      ">
        <p class="mb-2 text-body">{pair.answer}</p>
      </div>
    </div>
  ))}
</div>
