---
const { projects } = Astro.props;
import { Image } from "astro:assets";

interface Project {
    name: string;
    description: string;
    date: string;
    collaborator: string;
    url: string;
    image: any;
    imageAlt: string;
}
---

<section class="
  flex h-[calc(100vh-80px)] w-screen flex-col gap-8 bg-[#636B2F] p-12
  font-default
">
    <div class="mx-auto max-w-300">
        <h3 class="pt-4 text-3xl font-bold text-[#D4DE95]">Projects</h3>
        <div class="grid grid-cols-3 gap-4">
            {projects.map((project: Project) => (
                <a href={project.url}>
                    <div class="
                      flex h-35 flex-col items-center justify-center rounded-2xl
                      bg-[#3D4127] bg-cover opacity-50
                    ">
                    <h3 class="text-3xl font-bold text-black uppercase">{project.name}</h3>
                </div>
                </a>
                
            ))}
        </div>
    </div>
</section>