---
import { sanityClient } from "sanity:client";
import SanityImage from "../components/SanityImage.astro"

interface Project {
    name: string;
    dark: boolean;
    description: string;
    date: string;
    collaborator: string;
    url: string;
    image: any;
    imageAlt: string;
}

// Query projects from Sanity CMS
const PROJECTS_QUERY = `*[
  _type == "project"
]|order(date desc){collaborator, dark, date, description, image, imageAlt, name, url}`;

const projects = await sanityClient.fetch<Project[]>(PROJECTS_QUERY);
---

<section class="
  mx-auto h-[calc(100vh-80px)] max-w-300 font-default
  2xl:max-w-400
">
    <div class="
      mx-auto flex max-w-300 flex-col gap-8
      xl:max-w-400
    ">
        <h3 class="w-fit rounded-2xl px-8 py-6 text-3xl outline-2">Past Projects</h3>
        <div class="grid grid-cols-3 gap-4">
            {projects.map((project: Project) => (
                <a href={project.url} class="flex flex-col gap-2">
                    <SanityImage image={project.image} alt={project.imageAlt} class="
                      aspect-2804/1536 rounded-2xl border border-[#16180A]
                    "/>
                    <p class="text-center text-xl">{project.name}</p>
                </a>
            ))}
        </div>
    </div>
</section>