---
import { sanityClient } from "sanity:client";
import SanityImage from "../components/SanityImage.astro";
import serviceLilypad from "../assets/service-lilypad.svg";
import { cx } from "../lib/utils";
import pond from "../assets/pond.svg";

interface Service {
    name: string;
    description: string;
    image: any;
    imageAlt: string;
}

// Query services from Sanity CMS
const SERVICES_QUERY = `*[
  _type == "service"
]|order(orderRank){name, description, image, imageAlt}`;

const services = await sanityClient.fetch<Service[]>(SERVICES_QUERY);
---

<section id="services" class="
  relative mx-auto mb-30 flex h-[calc(100vh-80px)] max-w-300 flex-col gap-12
  font-default
">
    <h3 class="
      mt-30 text-center text-3xl underline decoration-wavy decoration-1
    ">Our Services</h3>
    <img src={pond.src} />
    <div class="
      absolute top-1/2 left-1/2 flex w-full -translate-x-1/2 flex-row
      justify-center gap-12
    ">
        {services.map((service, i) => {
          return (
            <div class="flex animate-float flex-col gap-2">
                <p class="text-center text-lg font-semibold capitalize">{service.name}</p>
                <SanityImage image={service.image} alt={service.imageAlt} class="
                  w-40 flex-1
                " />
            </div>
          )
        })}
    </div>
</section>

<script>
    import { gsap } from "gsap";
</script>