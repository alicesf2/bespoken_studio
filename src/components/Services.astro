---
import { sanityClient } from "sanity:client";
import SanityImage from "../components/SanityImage.astro";

interface Service {
    name: string;
    description: string;
    image: any;
    imageAlt: string;
}

// Query services from Sanity CMS
const SERVICES_QUERY = `*[
  _type == "service"
]|order(orderRank){name, description, image, imageAlt}`;

const services = await sanityClient.fetch<Service[]>(SERVICES_QUERY);
---

<section id="services" class="
  mx-auto mb-30 flex h-[calc(100vh-80px)] max-w-300 flex-col gap-12 font-default
">
    <h3 class="mt-30 w-fit rounded-2xl px-8 py-6 text-3xl outline-2">Our Services</h3>
    <div class="flex flex-row gap-4">
        {services.map(service => (
            <div class="text-center">
                <SanityImage image={service.image} alt={service.imageAlt} />
                <p class="text-lg">{service.name}</p>
            </div>
        ))}
    </div>
</section>

<script>
    import { gsap } from "gsap";
</script>