---
import { sanityClient } from "sanity:client";
import SanityImage from "../components/SanityImage.astro";
import serviceLilypad from "../assets/service-lilypad.svg";
import { cx } from "../lib/utils";

interface Service {
    name: string;
    description: string;
    image: any;
    imageAlt: string;
}

// Query services from Sanity CMS
const SERVICES_QUERY = `*[
  _type == "service"
]|order(orderRank){name, description, image, imageAlt}`;

const services = await sanityClient.fetch<Service[]>(SERVICES_QUERY);
---

<section id="services" class="
  mx-auto mb-30 flex h-screen max-w-300 flex-col gap-12 font-default
">
    <h3 class="
      mt-30 text-center text-3xl underline decoration-wavy decoration-1
    ">our services</h3>
    <div class="flex flex-row">
        {services.map((service, i) => {
          const isEven = i % 2 === 0;

          return (
            <div class={cx("animate-float text-center", isEven && "mt-48")}>
                {!isEven && <p>{service.description}</p>}
                <SanityImage image={service.image} alt={service.imageAlt} class="
                  scale-60
                " />
                <p class="-mt-12 text-lg">{service.name}</p>
                {isEven && <p>{service.description}</p>}
            </div>
          )
        })}
    </div>
</section>

<script>
    import { gsap } from "gsap";
</script>