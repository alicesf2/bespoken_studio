---
import { cx } from "../lib/utils";
const { id, class: className, text } = Astro.props;
---

<button
  id={id}
  class={cx(
    `
    w-fit cursor-pointer self-center rounded-4xl bg-green px-4 py-2
    font-default font-light text-white
    hover:bg-dark-green
  `,
    className,
  )}
>
  <slot />
  {text}
</button>
