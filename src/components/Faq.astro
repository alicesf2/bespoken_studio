---
import { sanityClient } from "sanity:client";
import Accordion from "./Accordion.astro"

export interface FAQ {
    question: string;
    answer: string;
}

// Query FAQ from Sanity CMS
const FAQ_QUERY = `*[
  _type == "faq"
]{question, answer}`;

const faqs = await sanityClient.fetch<FAQ[]>(FAQ_QUERY);
---

<section class="
  mx-auto flex h-[calc(100vh-80px)] w-screen max-w-300 flex-col gap-8
  font-default
  2xl:max-w-400
">
    <h3 class="text-3xl underline decoration-wavy decoration-1">FAQ</h3>
    <Accordion faqs={faqs} />
</section>
