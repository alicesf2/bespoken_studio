---
import CalendlyButton from "../components/CalendlyButton.astro";
import bespokenLogo from "../assets/bespoken-logo.svg";

const pages = ["about", "projects", "services", "faq", "blog"];
---

<nav
  id="navbar"
  class="mx-auto my-4 h-18 w-[95%] rounded-[48px] bg-white/30 shadow-lg backdrop-blur-2xl font-default font-light"
>
  <ol
    class="mx-auto flex h-full max-w-300 flex-row items-center justify-around
      xl:w-450"
  >
    <li>
      <a href="/" class="inline-flex items-baseline">
        <img src={bespokenLogo.src} class="mt-3 h-12 w-auto" />
      </a>
    </li>
    {pages.map((page) => (
      <li class="font-default text-2xl hover:underline decoration-2 underline-offset-3">
        <a href={`/${page}`}>{page}</a>
      </li>
    ))}
    <li>
      <CalendlyButton />
    </li>
  </ol>
</nav>
