---
import ButtonWrapper from "./ButtonWrapper.astro";

const { text = "Book consultation" } = Astro.props;
---

<ButtonWrapper class="consultation">{text}</ButtonWrapper>

<script is:inline>
    const calendlyScript = document.createElement('script');

	calendlyScript.src = 'https://assets.calendly.com/assets/external/widget.js';
	calendlyScript.async = true;

	calendlyScript.onload = () => {
		if (window.Calendly) {
            const consultationBtns = document.getElementsByClassName("consultation")
            console.log(consultationBtns)
            
            Array.from(consultationBtns).forEach(btn => btn.addEventListener("click", () => {
                Calendly.initPopupWidget({
                    url: 'https://calendly.com/alicesfang/bespoken-consultation'
                });
            }))
		}
	};

	document.head.appendChild(calendlyScript);
	
</script>